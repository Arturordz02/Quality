# ==============================================================================
# QUALITY CONSULTING SOLUTIONS - VARIABLES DE ENTORNO (.env.example)
# ==============================================================================
# Instrucciones:
# 1. Copie este archivo como '.env' en la raíz del proyecto.
# 2. Complete sus credenciales reales en el archivo '.env'.
# 3. NUNCA suba el archivo '.env' a repositorios Git públicos o privados.
# ==============================================================================

# Entorno de la aplicación ('production' o 'development')
APP_ENV=production
APP_DEBUG=false

# Dominios autorizados para peticiones CORS (separados por coma, sin comodín '*' en producción)
CORS_ALLOWED_ORIGINS=https://quality-consulting.org,https://www.quality-consulting.org

# Seguridad de Red y Rate Limiting
# En GoDaddy/cPanel sin proxy inverso, mantener en false para usar siempre REMOTE_ADDR
# y evitar falsificación de IP vía cabeceras X-Forwarded-For
TRUST_PROXY_HEADERS=false
TRUSTED_PROXIES=127.0.0.1,::1

# ------------------------------------------------------------------------------
# BASE DE DATOS (MySQL / MariaDB en cPanel / GoDaddy)
# ------------------------------------------------------------------------------
# Cambiar a true cuando haya creado la base de datos importando backend/schema.sql
DB_ENABLED=false
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=quality_web
DB_USER=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# ------------------------------------------------------------------------------
# SERVICIO DE CORREO ELECTRÓNICO (SMTP Corporativo)
# ------------------------------------------------------------------------------
# Driver: 'smtp' (recomendado) o 'mail' (función nativa mail() de PHP)
SMTP_DRIVER=smtp
SMTP_HOST=mail.quality-consulting.org
SMTP_PORT=465
SMTP_ENCRYPTION=ssl
SMTP_AUTH=true
SMTP_USER=contacto@quality-consulting.org
SMTP_PASSWORD=
SMTP_FROM_EMAIL=contacto@quality-consulting.org
SMTP_FROM_NAME="Quality Consulting Solutions"

# Buzones de destino para recepción de formularios
CONTACT_RECIPIENT=contacto@quality-consulting.org
CLAIM_RECIPIENT=contacto@quality-consulting.org

# Enviar copia digital automática al reclamante (true/false)
SMTP_SEND_COPY_CLAIMANT=true

# En desarrollo local únicamente, permitir certificados autofirmados (por defecto false)
# NUNCA tiene efecto en producción (solo si APP_ENV=development)
SMTP_ALLOW_SELF_SIGNED=false

# ------------------------------------------------------------------------------
# INFORMACIÓN CORPORATIVA (Plantillas de correo y pie legal)
# ------------------------------------------------------------------------------
COMPANY_NAME="Quality Consulting Solutions"
COMPANY_ADDRESS="Av. Javier Prado 757, piso 10, Magdalena del Mar, Lima 17, Perú"
COMPANY_PHONE="+51 993 463 118"
COMPANY_WEBSITE="https://quality-consulting.org"
LEGAL_RESPONSE_DAYS=15

# ------------------------------------------------------------------------------
# SEGURIDAD Y ANTI-BOTS
# ------------------------------------------------------------------------------
HONEYPOT_FIELD=_qcs_verification_hp

