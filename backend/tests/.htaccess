# ==============================================================================
# Quality Consulting Solutions - Protección de Pruebas Unitarias
# Bloqueo estricto de acceso HTTP directo a scripts de prueba
# ==============================================================================

# Apache 2.4
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Apache 2.2 y servidores antiguos
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>

# Deshabilitar listado de archivos y ejecución web
Options -Indexes -ExecCGI

<FilesMatch ".*">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

