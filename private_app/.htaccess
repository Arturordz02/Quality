# ==============================================================================
# QUALITY CONSULTING SOLUTIONS - PROTECCIÓN DE CÓDIGO PRIVADO
# Bloqueo total de acceso directo desde la web a la aplicación y backend interno
# ==============================================================================

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
    Satisfy All
</IfModule>
