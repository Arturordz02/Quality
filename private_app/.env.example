# ==============================================================================
# QUALITY CONSULTING SOLUTIONS - PLANTILLA DE VARIABLES DE ENTORNO
# Copia este archivo a 'private_app/.env' o usa 'private_app/env.php' en el servidor.
# NUNCA expongas contraseñas reales ni subas el archivo con credenciales a Git.
# ==============================================================================

# Entorno y Depuración
APP_ENV=production
APP_DEBUG=false
APP_URL=https://quality-consulting.org

# Base de Datos MySQL
DB_ENABLED=false
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Correo Saliente SMTP (Valores ilustrativos de referencia: reemplazar con el proveedor real de correo)
SMTP_DRIVER=smtp
SMTP_HOST=mail.quality-consulting.org
SMTP_PORT=465
SMTP_ENCRYPTION=ssl
SMTP_AUTH=true
SMTP_USER=contacto@quality-consulting.org
SMTP_PASSWORD=
SMTP_FROM_EMAIL=contacto@quality-consulting.org
SMTP_FROM_NAME="Quality Consulting Solutions"
CONTACT_RECIPIENT=contacto@quality-consulting.org
CLAIM_RECIPIENT=contacto@quality-consulting.org
SMTP_SEND_COPY_CLAIMANT=true

# Seguridad
HONEYPOT_FIELD=_qcs_verification_hp
CORS_ALLOWED_ORIGINS=https://quality-consulting.org,https://www.quality-consulting.org

# ==============================================================================
# PASARELA PAYPAL (PAGO EXCLUSIVO: PRIMERA CLASE DEL CURSO - USD 10)
# ==============================================================================
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=TU_PAYPAL_CLIENT_ID_AQUI
PAYPAL_CLIENT_SECRET=TU_PAYPAL_CLIENT_SECRET_AQUI
PAYPAL_CURRENCY=USD
PAYPAL_FIRST_CLASS_PRICE=10.00

# ==============================================================================
# NOTIFICACIONES DE COORDINACIÓN ACADÉMICA (PENDIENTE DE CONFIRMACIÓN)
# IMPORTANTE: No hardcodear ni inventar correos. Reemplazar este placeholder
# únicamente cuando la dirección confirme el correo oficial del Ing. Omar Samaniego.
# ==============================================================================
OMAR_SAMANIEGO_EMAIL=PLACEHOLDER_EMAIL_ING_OMAR_SAMANIEGO_PENDIENTE@ejemplo.com


