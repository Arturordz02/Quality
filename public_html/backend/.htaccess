# ==============================================================================
# QUALITY CONSULTING SOLUTIONS - PROTECCIÓN DE PROXIES PÚBLICOS DE BACKEND
# ==============================================================================

Options -Indexes

# Bloquear todo acceso por defecto
<IfModule mod_authz_core.c>
    <FilesMatch ".*">
        Require all denied
    </FilesMatch>
    <FilesMatch "^(send-contact\.php|submit-claim\.php|soft-skills\.php)$">
        Require all granted
    </FilesMatch>
</IfModule>

<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
    <FilesMatch "^(send-contact\.php|submit-claim\.php|soft-skills\.php)$">
        Allow from all
    </FilesMatch>
</IfModule>
