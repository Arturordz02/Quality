# ==============================================================================
# QUALITY CONSULTING SOLUTIONS - PROTECCIÓN DE PROXY API DE EVALUACIÓN
# ==============================================================================

Options -Indexes

<IfModule mod_authz_core.c>
    <FilesMatch ".*">
        Require all denied
    </FilesMatch>
    <FilesMatch "^soft-skills\.php$">
        Require all granted
    </FilesMatch>
</IfModule>

<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
    <FilesMatch "^soft-skills\.php$">
        Allow from all
    </FilesMatch>
</IfModule>
